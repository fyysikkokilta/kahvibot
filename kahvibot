#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Small python script for running a Telegram bot which takes a picture with a
webcam on certain commands or keywords.

Uses the python-telegram-bot library.
"""
#TODO: put image file in static path and host it so it can be accessed via an external API

from typing import Optional

import subprocess

import re

import logging
import logging.handlers

from tempfile import NamedTemporaryFile

from io import BytesIO

from PIL import Image

from telegram import (
    Update,
    Bot,
)

from telegram.utils.request import Request

from telegram.ext import (
    Updater,
    CommandHandler,
    MessageHandler,
    CallbackContext,
    CallbackQueryHandler,
    Filters,
)
import random
from telegram.constants import CHATACTION_UPLOAD_PHOTO

from config import (
    bot_token,
    admin_username,
    camera_dimensions,
    watermark_path,
    watermark_path_alt,
    trigger_words,
)

# Coffee level reader (optional, defaults keep the bot exactly as before).
# The reader is a separate short-lived subprocess so that nothing about it -
# a missing model file, a crash, an OOM - can take the bot down: any failure
# just means this photo goes out without a reading, like every photo did
# before the reader existed.
import config as _config
import json
from datetime import datetime, timezone

# Command to run, e.g. ["/home/pi/coffee-reader/venv/bin/python",
#                       "/home/pi/coffee-reader/read_frame.py"].
# Empty list = reader disabled.
coffee_reader_cmd = getattr(_config, "coffee_reader_cmd", [])
coffee_reader_timeout = getattr(_config, "coffee_reader_timeout", 30)
# Show the reading to users. Keep False for the burn-in period: readings are
# still logged, so drift can be caught before anything is user-visible.
coffee_reader_show = getattr(_config, "coffee_reader_show", False)
# JSONL log of every reading (empty string disables logging).
coffee_reader_log = getattr(_config, "coffee_reader_log", "")
# Advisory camera lock shared with the background sampler. Empty string
# (the default) is byte-for-byte today's behaviour: no lock, no sampler.
camera_lock = getattr(_config, "camera_lock", "")
# /graph: today's level curve. Off by default (GRAPHS.md §8 step 4).
coffee_graph_enabled = getattr(_config, "coffee_graph_enabled", False)

logger = logging.getLogger("kahvibot")
log_handler = logging.handlers.SysLogHandler(address="/dev/log")
log_handler.setFormatter(logging.Formatter("%(module)s[%(process)s]: %(message)s"))
logger.addHandler(log_handler)
logger.setLevel(logging.INFO)

# Annotation surveys (UX_FEEDBACK.md). None whenever disabled or misconfigured,
# and every hook below no-ops on None - the photo always goes out regardless.
try:
    import feedback as _feedback
    survey = _feedback.FeedbackManager.from_config(_config, logger)
except Exception:
    logger.warning("survey module unavailable", exc_info=True)
    survey = None

HELP_TEXT_FMT = """
Komennot / commands:
/status - Näytä kahvin määrä kiltiksellä tällä hetkellä / Show the current amount of coffee at the guild room
/graph - Näytä kahvin määrä päivän aikana / Show today's coffee level over time
/merkkaa - Merkitse kahvin pinta yhteen kuvaan / Mark the coffee surface on one photo
/eikiitos - Älä kysy minulta enää / Stop asking me
/help - Näytä tämä viesti / Show this message

Onko jokin vialla? Onko sinulla parannusehdotus? Ota yhteyttä ylläpitäjään {0}.
Is something wrong? Do you have a feature request? Contact the administrator {0}.
"""


class CustomBot(Bot):
    """
    Simple custom telegram bot class with some extra attributes.
    """
    def __init__(self,
        admin_username: str,
        watermark_path: str = "",
        **kwargs
    ):

        super().__init__(**kwargs)

        # prepend '@' if applicable
        if not admin_username.startswith("@"):
            admin_username = "@" + admin_username

        self.admin_username = admin_username
        self.help_text = HELP_TEXT_FMT.format(admin_username)

        self.watermark: Optional[Image] = None
        if watermark_path:  # don't add watermark if the path is empty
            self.watermark = Image.open(watermark_path)
            logger.info(f"Using watermark {watermark_path}")
            if self.watermark.size != camera_dimensions:
                logger.warning(f"Warning: watermark size is different from camera size: {self.watermark.size} vs {camera_dimensions}")

        self.watermark_alt: Optional[Image] = None
        if watermark_path_alt:  # don't add watermark if the path is empty
            self.watermark_alt = Image.open(watermark_path_alt)
            logger.info(f"Using watermark {watermark_path_alt}")
            if self.watermark_alt.size != camera_dimensions:
                logger.warning(f"Warning: watermark size is different from camera size: {self.watermark_alt.size} vs {camera_dimensions}")


def send_help(update: Update, ctx: CallbackContext):
    msg = update.message
    if msg:
        msg.reply_text(ctx.bot.help_text)


def start_router(update: Update, ctx: CallbackContext):
    # A deep-linked "/start s<token>" opens a survey in this private chat;
    # every other /start is plain help, exactly as before.
    if survey and survey.on_start(update, ctx):
        return
    send_help(update, ctx)


def read_coffee_level(image_path: str) -> Optional[dict]:
    """
    Run the coffee level reader on the captured frame, if configured.

    Returns the parsed reading record, or None. None is the *normal* answer
    for any kind of trouble - reader not configured, subprocess died, timed
    out, printed garbage - because the bot's product is the photo and a
    missing number must never block it.
    """
    if not coffee_reader_cmd:
        return None
    record = None
    try:
        proc = subprocess.run(
            list(coffee_reader_cmd) + [image_path],
            capture_output=True, text=True, timeout=coffee_reader_timeout,
        )
        record = json.loads(proc.stdout.strip().splitlines()[-1])
    except Exception:
        logger.warning("coffee reader failed", exc_info=True)
    # Log failures too, not just successes: the burn-in question is "what
    # fraction of photos yields a reading", and a log that only sees successes
    # cannot answer it. The log path is a strftime pattern, so a value like
    # "readings-%Y-%m.jsonl" rotates monthly for free (a plain path, having no
    # % codes, passes through strftime unchanged).
    if coffee_reader_log:
        entry = record if isinstance(record, dict) else {"error": "reader produced no JSON"}
        entry.setdefault("captured_at",
                         datetime.now(timezone.utc).isoformat(timespec="seconds"))
        try:
            with open(datetime.now().strftime(coffee_reader_log), "a", encoding="utf-8") as fh:
                fh.write(json.dumps(entry) + "\n")
        except OSError:
            logger.warning("coffee reader log write failed", exc_info=True)
    if not isinstance(record, dict) or "pots" not in record:
        return None
    return record


# Display names for the two camera-frame sides.
POT_NAMES = {"left": "vasen pannu / left pot", "right": "oikea pannu / right pot"}


def format_reading(record: dict) -> str:
    """
    One caption line per detected pot, honest about precision: the model's
    median error is ~29 ml, so volumes are phrased as cups to the nearest
    half (a half cup is 62 ml) and never as exact millilitres. A pot whose
    surface the model can't see gets a "can't tell", which is a correct
    answer, not a failure.
    """
    lines = []
    for pot in record.get("pots", []):
        name = POT_NAMES.get(pot.get("side"), pot.get("side", "?"))
        if pot.get("ok") and pot.get("volume_ml") is not None:
            half_cups = round(pot["volume_ml"] / 62.5) / 2
            if half_cups <= 0:
                amount = "tyhjä / empty"
            else:
                cups = ("%g" % half_cups).replace(".5", "½")
                amount = f"~{cups} kuppia / cups"
            lines.append(f"☕ {name}: {amount}")
        else:
            lines.append(f"☕ {name}: en näe pintaa / can't tell")
    return "\n".join(lines)


def take_picture() -> "tuple[Image, Optional[dict], bytes]":
    """
    Take picture from webcamera using the fswebcam command and return it as a
    pillow image, plus the coffee level reading (or None) measured from the
    frame on disk before it is watermarked or re-encoded, plus the raw
    pre-watermark JPEG bytes (the survey caches the frame the reader saw).
    """
    with NamedTemporaryFile(suffix=".jpg") as f:
        # Use the option "-S 20" to discard 20 frames before taking the picture,
        # so that the camera has time to adjust the brightness automatically.
        # This takes ~1-2s, the camera usually does 10-20fps.
        # Use --no-banner to not put a banner on the picture, which fswebcam
        # does by default for some reason.

        #NOTE: fswebcam v 20140113 (available on Debian 11 Bullseye) doesn't
        # return nonzero exit status on error... so we will get an exception
        # from the Image.open() call below if taking the picture fails, even
        # with check=True ...
        w, h = camera_dimensions
        cmd = ["fswebcam", "--quiet", "-S", "20", "--no-banner",
               "--resolution", f"{w}x{h}", f.name]
        if camera_lock:
            # The sampler may be mid-capture: wait briefly for the shared
            # lock, then take the shot anyway - the user's photo is never
            # gated on the lock, a missing flock binary, or a wedged sampler.
            try:
                locked = subprocess.run(["flock", "-w", "5", camera_lock] + cmd)
            except OSError:
                subprocess.run(cmd, check=True)
            else:
                if locked.returncode != 0:
                    subprocess.run(cmd, check=True)
        else:
            subprocess.run(cmd, check=True)
        img = Image.open(f.name)
        reading = read_coffee_level(f.name)
        with open(f.name, "rb") as fh:
            raw = fh.read()
    return img, reading, raw


def send_webcam_photo(update: Update, ctx: CallbackContext):
    bot = ctx.bot

    update.message.reply_chat_action(action=CHATACTION_UPLOAD_PHOTO)

    img, reading, raw = take_picture()

    if bot.watermark is not None:
        # Use the watermark image as the mask as well, so it's alpha channel is
        # used. See the the pillow Image.paste() docs for details.
        if random.random() < 0.1 and bot.watermark_alt is not None:
            img.paste(bot.watermark_alt, mask=bot.watermark_alt)
        else:
            img.paste(bot.watermark, mask=bot.watermark)

    # img.tobytes() didn't work for some reason, so using BytesIO.
    # see https://stackoverflow.com/a/54165463
    bio = BytesIO()
    bio.name = "image.jpg"
    img.save(bio, "JPEG")
    bio.seek(0)

    caption = None
    if coffee_reader_show and reading is not None:
        caption = format_reading(reading) or None

    offer = markup = None
    if survey and update.effective_user:
        offer = survey.maybe_offer(update.effective_user.id, reading)
        extra, markup = survey.decorate(offer, reading_shown=bool(caption))
        if extra:
            caption = (caption + "\n\n" + extra) if caption else extra

    msg = update.message
    if msg:
        sent = msg.reply_photo(bio, caption=caption, reply_markup=markup)
        if survey:
            survey.register_photo(sent, raw, reading, offer)


def send_graph(update: Update, ctx: CallbackContext):
    """
    /graph - today's coffee level as a picture. The failure discipline is
    read_coffee_level()'s: any exception degrades to a text reply, because a
    broken graph must never take out the bot.
    """
    msg = update.message
    if msg is None:
        return
    if not coffee_graph_enabled:
        return  # feature off: stay silent, same as any unknown command
    try:
        import graphs
        png, caption = graphs.graph_reply(coffee_reader_log)
    except Exception:
        logger.warning("graph render failed", exc_info=True)
        png = None
        caption = ("Kuvaajan piirto epäonnistui. Kokeile hetken päästä uudelleen.\n"
                   "Couldn't draw the graph. Try again in a moment.")
    if png is None:
        msg.reply_text(caption)
        return
    msg.reply_chat_action(action=CHATACTION_UPLOAD_PHOTO)
    bio = BytesIO()
    bio.write(png)
    bio.name = "graph.png"
    bio.seek(0)
    msg.reply_photo(bio, caption=caption)


def error_callback(update, context):
    logger.error("Caught exception")
    logger.error("", exc_info=True)


if __name__ == "__main__":

    logging.basicConfig(level=logging.INFO)

    if not bot_token:
        raise ValueError("Telegram bot token not provided (did you set it in the configuration?)")
    if not admin_username:
        raise ValueError("admin_username not defined in config file.")

    # initialize custom bot class
    bot = CustomBot(
        admin_username=admin_username,
        token=bot_token,
        watermark_path=watermark_path,
        # this gets rid of some warnings (and maybe connection problems?)
        request=Request(con_pool_size=8),
    )
    updater = Updater(bot=bot, use_context=True)

    dispatcher = updater.dispatcher
    dispatcher.add_handler(CommandHandler("start", start_router))
    dispatcher.add_handler(CommandHandler("help", send_help))
    dispatcher.add_handler(CommandHandler("status", send_webcam_photo))
    dispatcher.add_handler(CommandHandler("graph", send_graph))
    dispatcher.add_handler(CommandHandler("kuvaaja", send_graph))
    if survey:
        # Survey handlers must sit above any Filters.text catch-all: within
        # one group the first matching handler wins.
        dispatcher.add_handler(CallbackQueryHandler(survey.on_callback, pattern=r"^fb\|"))
        dispatcher.add_handler(CommandHandler("merkkaa", survey.on_merkkaa))
        dispatcher.add_handler(CommandHandler("eikiitos", survey.on_eikiitos))
        dispatcher.add_handler(CommandHandler("kahvistatsit", survey.on_stats))
        survey.schedule_jobs(updater.job_queue)
    trigger_words_regex = re.compile("|".join(trigger_words), re.IGNORECASE)
    dispatcher.add_handler(MessageHandler(Filters.text & Filters.regex(trigger_words_regex), send_webcam_photo))
    dispatcher.add_error_handler(error_callback)

    # NOTE: when the raspi reboots, start_polling fails with a name resolution
    # error even with bootstrap_retries=-1 for some reason. After a lot of
    # troubleshooting, we ended up just configuring the systemd to restart the
    # service automatically, see setup.py.
    updater.start_polling(drop_pending_updates=True, bootstrap_retries=-1)
    updater.idle()
