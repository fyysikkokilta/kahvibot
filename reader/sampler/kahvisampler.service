# Coffee level background sampler — SAMPLER.md §4 unit sketch, adapted.
#
# One deliberate deviation from the sketch: User=konsta instead of
# DynamicUser=yes. SAMPLER.md §6 requires ONE readings JSONL shared with the
# bot (which appends as root to /home/konsta/coffee-reader/readings-*.jsonl);
# a DynamicUser's transient UID cannot own or reliably write that file. konsta
# is still unprivileged, and every other containment line survives.
#
# Kill switch (no systemd knowledge needed): touch /etc/kahvi-sampler/disabled
# Remove the feature entirely:              systemctl disable --now kahvisampler

[Unit]
Description=Coffee level background sampler
# The Pi 3B has no RTC: don't start stamping records before NTP.
After=time-sync.target network-online.target
Wants=time-sync.target

[Service]
Type=notify
NotifyAccess=main
# Daemon pings WATCHDOG=1 every loop pass; a numpy wedge or stuck fswebcam
# becomes a restart in <=2 min instead of a silent dead service.
WatchdogSec=120
User=konsta
Group=konsta
SupplementaryGroups=video
ExecStart=/home/konsta/coffee-reader/venv/bin/python /home/konsta/coffee-reader/sampler.py
# /run/kahvi-sampler: tmpfs, auto-cleaned — frames never touch the SD card.
RuntimeDirectory=kahvi-sampler
# /var/lib/kahvi-sampler: the 500 MB retained-frame FIFO ring.
StateDirectory=kahvi-sampler

# "When the Pi isn't busy" as a scheduler guarantee, not a poll: a sampler
# tick literally cannot delay the bot's work.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# Belt to SCHED_IDLE's braces: even a spinning bug cannot become Jun-14.
CPUQuota=25%
# Under memory pressure the kernel kills the sampler, never the bot.
MemoryHigh=150M
MemoryMax=200M
OOMScoreAdjust=500

Restart=always
RestartSec=30
StartLimitIntervalSec=1h
StartLimitBurst=5
# Runaway logging is not hypothetical on this host (Jun 14-17).
LogRateLimitIntervalSec=60
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
